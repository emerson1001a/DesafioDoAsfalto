SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Meta Pixel (valor público, usado no navegador e no servidor)
NEXT_PUBLIC_META_PIXEL_ID=seu_pixel_id
META_PIXEL_ID=seu_pixel_id

# Meta Conversions API (segredo; nunca use NEXT_PUBLIC_ neste token)
META_CONVERSIONS_API_TOKEN=seu_token_secreto
# Opcional: altere quando a Meta orientar uma nova versão
META_GRAPH_API_VERSION=v23.0
